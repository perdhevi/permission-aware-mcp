APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://permission_mcp:permission_mcp@localhost:5432/permission_mcp?sslmode=disable
AUTH_MODE=dev
AUTH_ISSUER=http://dev.local
AUTH_AUDIENCE=permission-aware-mcp
DEV_JWT_PUBLIC_KEY_FILE=.local/keys/public.pem
REQUIRED_SCOPE=knowledge:read

